{
  "name": "autobs",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@autobs/web",
    "dev:server": "turbo run dev --filter=@autobs/server",
    "build": "turbo run build",
    "playwright:install": "pnpm dlx playwright install chromium",
    "playwright:install-deps": "pnpm dlx playwright install-deps",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e:real": "AUTOBS_REAL_E2E=true pnpm --filter @autobs/server test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "vue-demi"]
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  }
}
